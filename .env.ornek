# Bu dosyayi .env olarak kopyalayip kendi anahtarlarinizi yazin.
# Panel > Kaynaklar sekmesinden de girebilirsiniz (kaydedince otomatik test edilir).

# --- SENARYO MOTORU: ikisinden EN AZ BIRI gerekir ---
# (ya da senaryoyu kendin yazip panelde Senaryo kutusuna yapistirirsin)
# Claude (Anthropic) — console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Istege bagli: kullanilacak model. Bos birakirsan panel-ayar.json'daki claudeModel (varsayilan claude-opus-5).
ANTHROPIC_MODEL=
# vidIQ — app.vidiq.com/account/settings/mcp
VIDIQ_KEY=

# --- GORSEL KAYNAKLARI (istege bagli; hicbiri zorunlu degil) ---
PEXELS_KEY=
PIXABAY_KEY=
SMITHSONIAN_KEY=
UNSPLASH_KEY=
EUROPEANA_KEY=

# --- GORSEL URETIMI (hepsi istege bagli) ---
# Hicbiri yoksa Pollinations kullanilir; o anahtar istemiyor.
CF_ACCOUNT_ID=
CF_API_TOKEN=
TOGETHER_KEY=
HF_TOKEN=

# --- MALIYET VE GORSEL SINIRLARI (istege bagli) ---
# Tek is icin tahmini ucretli cagri ust siniri (USD); asilacaksa betik baslamadan cikis kodu 7 verir.
# (konu.json'daki maliyetUstSinirUSD ve panel-ayar maliyet.isBasinaUSD bunun ustundedir.)
MALIYET_UST_SINIR_USD=
# Pexels/Pixabay istek sinirina (429) takilinca kaynagi kapatmak yerine en cok bu kadar saniye bekle (gece toplu isi: 3600).
GORSEL_LIMIT_BEKLE_SN=
# Gorsel/API adresi "yerel ag adresine cozulen ad" diye reddediliyorsa (kurumsal DNS, bazi VPN'ler) 1 yaz: ad cozumleme denetimini kapatir.
# (Clash/Surge "fake-ip" modu zaten sorun cikarmaz; dogrudan yerel IP adresleri yine reddedilir.)
GORSEL_YEREL_AG_IZIN=

# --- RENDER (istege bagli) ---
# VIDEO_KODEK=cpu      GPU kodlayiciyi hic deneme (surucu sorunlarinda)
# RENDER_ONCELIK=normal   Render surecini normal oncelikle calistir (varsayilan: dusuk, bilgisayar kasmasin)
# RENDER_DUSUK_BELLEK=1   Bellegi az bilgisayarda (8 GB ve alti) renderi bastan dusuk bellek moduyla kur: klipler tek tek,
#                         az is parcacigi, kisa x264 on-bakisi. Daha yavas; cozunurluk, kare hizi ve kalite AYNI.
#                         2 = en az bellek (en yavas), 0 = bos bellege bakip kendiliginden acma. Bos birakilirsa: bos bellek
#                         3 GB'in altindaysa kendiliginden acilir. Her durumda "Cannot allocate memory" gibi bir bellek hatasinda
#                         o adim bu modla bir kez kendiliginden yeniden denenir.
# FFMPEG_YOLU=         ffmpeg bulunamazsa tam yol (FFPROBE_YOLU da ayni sekilde)

# --- SESLENDIRME MOTORLARI (istege bagli) ---
# Varsayilan Microsoft Edge sesli okuma (anahtarsiz, ama RESMI bir API DEGIL; ticari kullanim hakki belirsizdir).
# Resmi yedek: Azure Speech (portal.azure.com > Speech)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Yerel yedek: Piper (anahtarsiz, internet gerektirmez)
PIPER_YOL=
PIPER_MODEL=
# Yerel ekran karti sesi: VoxCPM2 (anahtarsiz, ucretsiz; 14 hazir yapay ses: sesler/voxcpm2/README.md)
# Once https://github.com/alexturkey/voxcpm2-turkce-ses-tasarimi deposunu klonlayip scripts\kur.ps1 ile kur,
# sonra KLONLANAN DEPONUN klasorunu yaz (kur.ps1'in -Kok klasoru degil), or. VOXCPM_KOK=C:\voxcpm2
# Kullanim: node seslendir.js <is> --ses voxcpm:tok_anlatici   (ya da --motor voxcpm; kontrol: --liste-sesler)
VOXCPM_KOK=
# Istege bagli: Python yolu (bos = <VOXCPM_KOK>\.venv\Scripts\python.exe, Mac/Linux'ta .venv/bin/python;
# goreli yol VOXCPM_KOK'a gore; .bat/.cmd olamaz)
VOXCPM_PYTHON=
